# NirogCare - Environment Configuration Reference
# SECURITY NOTICE: Never commit real API keys or secrets to version control.
# Variables prefixed without VITE_ are strictly SERVER-SIDE ONLY.

# ==========================================
# 1. SERVER-SIDE BACKEND KEYS (Secret - Never in browser bundle)
# ==========================================
# Google Gemini API Key (Brain of NirogCare)
# Used server-side only in /api/chat & /api/ocr/prescription
GEMINI_API_KEY=your_gemini_api_key_here

# RAVATAR Live Digital Human Integration
# Used server-side to mint pseudonymous JWT tokens (/api/ravatar/token)
RAVATAR_PROJECT_ID=your_ravatar_project_id_here
RAVATAR_API_KEY=your_ravatar_api_key_here

# Optional: ElevenLabs Voice Integration (for Assamese & regional voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Google Cloud Vision / Vertex AI Service Account Credentials
# (JSON string or path to service-account-key.json)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==========================================
# 2. CLIENT-SIDE VARIABLES (Safe public values)
# ==========================================
# Supabase Configuration (Optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Firebase Client Configuration (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
